[Unit]
Description=unoserver — warm headless LibreOffice for hazreq PDF conversion
After=network.target

[Service]
Type=simple
User=hazreq
Group=hazreq
ExecStart=/opt/hazreq/.venv/bin/unoserver --port 2003 --interface 127.0.0.1
Restart=on-failure
RestartSec=5
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
